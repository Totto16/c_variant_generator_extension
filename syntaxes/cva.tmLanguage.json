{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "C Variants",
	"scopeName": "source.cva",
	"foldingStartMarker": "\\{",
	"foldingStopMarker": "\\}",
	"regex-docs": "https://macromates.com/manual/en/regular_expressions",
	"patterns": [
		{
			"include": "#variant"
		},
		{
			"include": "#keyword"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#comment"
		}
	],
	"repository": {
		"variant": {
			"begin": "(variant)\\s+",
			"end": "\\s*(\\})",
			"name": "entity.variant.cva",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.variant.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.variant.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#variant_member_name"
				},
				{
					"include": "#variant_member_content"
				},
				{
					"include": "#comment"
				}
			]
		},
		"variant_member_name": {
			"begin": "(?<=(?:variant)\\s+)",
			"end": "(\\{)\\s*",
			"beginCaptures": {},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.variant.start.cva"
				}
			},
			"patterns": [
				{
					"include": "#variant_member_name_impl"
				}
			]
		},
		"variant_member_name_impl": {
			"patterns": [
				{
					"include": "#identifier"
				}
			]
		},
		"variant_member_content": {
			"patterns": [
				{
					"include": "#variant_member_content_impl"
				},
				{
					"include": "#keyword"
				},
				{
					"include": "#punctuation"
				},
				{
					"include": "#comment"
				}
			]
		},
		"variant_member_content_impl": {
			"patterns": [
				{
					"include": "#variant_member_content_enum"
				},
				{
					"include": "#variant_member_content_options"
				},
				{
					"include": "#variant_member_content_entry"
				}
			]
		},
		"variant_member_content_enum": {
			"begin": "(enum)\\s+",
			"end": "\\s*(\\})",
			"name": "entity.enum.cva",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.enum.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.enum.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#enum_member_name"
				},
				{
					"include": "#enum_member_content"
				},
				{
					"include": "#comment"
				}
			]
		},
		"enum_member_name": {
			"begin": "(?<=(?:enum)\\s+)",
			"end": "(\\{)\\s*",
			"beginCaptures": {},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.enum.start.cva"
				}
			},
			"patterns": [
				{
					"include": "#enum_member_name_impl"
				}
			]
		},
		"enum_member_name_impl": {
			"patterns": [
				{
					"include": "#identifier"
				}
			]
		},
		"enum_member_content": {
			"patterns": [
				{
					"include": "#enum_member_content_impl"
				},
				{
					"include": "#comment"
				}
			]
		},
		"enum_member_content_impl": {
			"patterns": [
				{
					"include": "#type_expression_simple"
				}
			]
		},
		"type_expression": {
			"patterns": [
				{
					"include": "#type_expression_simple"
				},
				{
					"include": "#type_expression_struct"
				}
			]
		},
		"type_expression_struct": {
			"begin": "(struct)\\s+(\\{)",
			"end": "\\s*(\\})",
			"name": "entity.struct.cva",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.struct.cva"
				},
				"2": {
					"name": "punctuation.definition.struct.start.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.struct.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#struct_content"
				},
				{
					"include": "#comment"
				}
			]
		},
		"struct_content": {
			"patterns": [
				{
					"include": "#variant_member_content_entry"
				}
			]
		},
		"type_expression_simple": {
			"begin": "(type)\\s+",
			"end": "$",
			"name": "entity.type.cva",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.type.cva"
				},
				"2": {
					"name": "punctuation.definition.type.start.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.type.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#type_name_builtin"
				},
				{
					"include": "#type_name_user"
				},
				{
					"include": "#comment"
				}
			]
		},
		"type_name_builtin": {
			"name": "type.name.cva",
			"match": "\\b(bool|u8|u16|u32|u64)\\b",
			"captures": {
				"1": {
					"name": "storage.type.built-in.cva"
				}
			}
		},
		"type_name_user": {
			"patterns": [
				{
					"include": "#identifier"
				}
			]
		},
		"variant_member_content_options": {
			"begin": "(options)\\s+(\\{)",
			"end": "\\s*(\\})",
			"name": "entity.options.cva",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.options.cva"
				},
				"2": {
					"name": "punctuation.definition.options.start.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.options.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#options_member_content"
				},
				{
					"include": "#comment"
				}
			]
		},
		"options_member_content": {
			"patterns": [
				{
					"include": "#options_member_content_impl"
				}
			]
		},
		"options_member_content_impl": {
			"begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s+(\\{)",
			"end": "\\s*(\\})",
			"name": "entity.option.member.cva",
			"beginCaptures": {
				"1": {
					"name": "entity.name.function.call.option.member.cva"
				},
				"2": {
					"name": "punctuation.definition.option.member.start.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.option.member.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#options_member_content_impl_content"
				},
				{
					"include": "#comment"
				}
			]
		},
		"options_member_content_impl_content": {
			"patterns": [
				{
					"include": "#options_member_content_impl_content_impl"
				},
				{
					"include": "#comment"
				}
			]
		},
		"options_member_content_impl_content_impl": {
			"patterns": [
				{
					"include": "#general_expression_simple"
				}
			]
		},
		"general_expression_simple": {
			"begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s+(?!\\{)",
			"end": "$",
			"name": "entity.option.member.entry.cva",
			"beginCaptures": {
				"1": {
					"name": "entity.name.function.call.option.member.entry.cva"
				},
				"2": {
					"name": "punctuation.definition.option.member.entry.start.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.option.member.entry.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#identifier"
				},
				{
					"include": "#comment"
				}
			]
		},
		"variant_member_content_entry": {
			"begin": "(entry)\\s+",
			"end": "\\s*(\\})",
			"name": "entity.entry.cva",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.entry.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.entry.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#entry_member_name"
				},
				{
					"include": "#entry_member_content"
				},
				{
					"include": "#comment"
				}
			]
		},
		"entry_member_name": {
			"begin": "(?<=(?:entry)\\s+)",
			"end": "(\\{)\\s*",
			"beginCaptures": {},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.entry.start.cva"
				}
			},
			"patterns": [
				{
					"include": "#entry_member_name_impl"
				}
			]
		},
		"entry_member_name_impl": {
			"patterns": [
				{
					"include": "#identifier"
				}
			]
		},
		"entry_member_content": {
			"patterns": [
				{
					"include": "#entry_member_content_impl"
				},
				{
					"include": "#keyword"
				},
				{
					"include": "#punctuation"
				},
				{
					"include": "#comment"
				}
			]
		},
		"entry_member_content_impl": {
			"patterns": [
				{
					"include": "#type_expression"
				}
			]
		},
		"identifier": {
			"patterns": [
				{
					"include": "#identifier_string"
				},
				{
					"include": "#identifier_raw"
				}
			]
		},
		"identifier_raw": {
			"name": "variable.name.cva",
			"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?:\\b|$)([\\*]*)",
			"captures": {
				"1": {
					"name": "entity.name.raw.cva"
				},
				"2": {
					"name": "keyword.operator.arithmetic.ptr.cva"
				}
			}
		},
		"identifier_string": {
			"name": "variable.name.cva",
			"match": "(?:(\")([a-zA-Z0-9_]*[\\*]*)(\"))",
			"captures": {
				"1": {
					"name": "punctuation.definition.string.begin.cva"
				},
				"2": {
					"name": "string.quoted.double.cva"
				},
				"3": {
					"name": "punctuation.definition.string.end.cva"
				}
			}
		},
		"comment": {
			"patterns": [
				{
					"include": "#comment_single_line"
				},
				{
					"include": "#comment_multi_line_empty"
				},
				{
					"include": "#comment_multi_line_doc"
				},
				{
					"include": "#comment_multi_line_normal"
				},
				{
					"include": "#empty_line"
				}
			]
		},
		"comment_single_line": {
			"name": "comment.line.double-slash.cva",
			"match": "\\s*(//)(.*)",
			"captures": {
				"1": {
					"name": "punctuation.definition.comment.single_line.cva"
				},
				"2": {
					"name": "comment.line.double-slash.content.cva"
				}
			}
		},
		"comment_multi_line_empty": {
			"name": "comment.block.block.empty.cva",
			"match": "\\s*(/\\**/)",
			"captures": {
				"1": {
					"name": "punctuation.definition.comment.block.empty.cva"
				}
			}
		},
		"comment_multi_line_doc": {
			"name": "comment.block.documentation.cva",
			"begin": "\\s*(/\\*{2})",
			"end": "(\\*/)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.comment.block.doc.start.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.comment.block.doc.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#empty_line"
				},
				{
					"include": "#comment_multi_line_end"
				},

				{
					"include": "#comment_doc"
				}
			]
		},

		"comment_multi_line_end": {
			"match": ".+?(?=\\*/)",
			"captures": {
				"1": {
					"name": "punctuation.definition.comment.block.multi_line.end.cva"
				}
			}
		},

		"comment_multi_line_normal": {
			"name": "comment.block.cva",
			"begin": "\\s*(/\\*)",
			"end": "(\\*/)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.comment.block.multi_line.start.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.comment.block.multi_line.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#empty_line"
				},

				{
					"include": "#comment_multi_line_end_opt"
				}
			]
		},
		"comment_multi_line_end_opt": {
			"match": ".*?(?=\\*/)",
			"captures": {
				"1": {
					"name": "punctuation.definition.comment.block.multi_line.end.cva"
				}
			}
		},
		"empty_line": {
			"name": "entity.empty-line.cva",
			"match": "^(\\s*)$",
			"captures": {
				"1": {
					"name": "entity.empty-line.content.cva"
				}
			}
		},
		"comment_doc": {
			"patterns": [
				{
					"include": "#comment_doc_block_attributes"
				},
				{
					"include": "#comment_doc_block_content"
				}
			]
		},
		"comment_doc_block_attributes": {
			"name": "comment.block.documentation.cva.doc",
			"match": "\\s*\\*\\s+(@)([a-z][a-zA-Z0-9_\\.]*)\\s+(.*)",
			"captures": {
				"1": {
					"name": "punctuation.decorator.cva.doc"
				},
				"2": {
					"name": "storage.type.class.cva.doc"
				},
				"3": {
					"name": "comment.block.documentation.cva.doc.raw"
				}
			}
		},
		"comment_doc_block_content": {
			"name": "comment.block.documentation.cva",
			"match": "\\s*\\*\\s+(.*)",
			"captures": {
				"1": {
					"name": "comment.block.documentation.cva"
				}
			}
		},
		"keyword": {
			"match": "(?:\\b(variant|enum|entry|type|options|struct)\\b)",
			"name": "entity.keyword.cva",
			"captures": {
				"0": { "name": "keyword.control.type.cva" }
			}
		},
		"punctuation": {
			"match": "(?:\\b(\\{|\\}|\")\\b)",
			"name": "entity.punctuation.cva",
			"captures": {
				"0": { "name": "punctuation.any.cva" }
			}
		}
	}
}
