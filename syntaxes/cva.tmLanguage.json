{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "C Variants",
	"scopeName": "source.cva",
	"foldingStartMarker": "{",
	"foldingStopMarker": "}",
	"TODO": "this is just WIP, it has to be improved a lot!",
	"regex-docs": "https://macromates.com/manual/en/regular_expressions",
	"patterns": [
		{
			"include": "#variant"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#keyword"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"variant": {
			"begin": "(variant)\\s+",
			"end": "\\s*(\})",
			"name": "entity.class.cva",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.variant.cva"
				}
			},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.variant.end.cva"
				}
			},
			"patterns": [
				{
					"include": "#variant_member_name"
				},
				{
					"include": "#variant_member_content"
				},
				{
					"include": "#comment"
				}
			]
		},
		"variant_member_name": {
			"begin": "(?<=(?:variant)\\s+)",
			"end": "(\{)\\s*",
			"beginCaptures": {},
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.variant.start.cva"
				}
			},
			"patterns": [
				{
					"include": "#variant_member_name_impl"
				}
			]
		},
		"variant_member_name_impl": {
			"patterns": [
				{
					"include": "#identifier"
				}
			]
		},
		"variant_member_content": {
			"patterns": [
				{
					"include": "#comment"
				}
			]
		},
		"identifier": {
			"patterns": [
				{
					"include": "#identifier_raw"
				},
				{
					"include": "#identifier_string"
				}
			]
		},
		"identifier_raw": {
			"name": "variable.name.cva",
			"match": "\\b([a-z][a-zA-Z0-9_]*)\\b",
			"captures": {
				"1": {
					"name": "variable.name.raw.cva"
				}
			}
		},
		"identifier_string": {
			"name": "variable.name.cva",
			"match": "\\b(\"([a-zA-Z0-9_]*[*]*)\")\\b",
			"captures": {
				"1": {
					"name": "variable.name.string.cva"
				}
			}
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.line.double-slash.cva",
					"match": "\\s*//.*"
				},
				{
					"name": "comment.block.block.empty.cva",
					"match": "\\s*/\\**/"
				},
				{
					"name": "comment.block.documentation.cva",
					"begin": "\\s*/\\*{2}",
					"end": "\\*/",
					"patterns": [
						{
							"include": "#empty_line"
						},
						{
							"match": ".+?(?=\\*/)"
						},
						{
							"include": "#comment_doc"
						}
					]
				},
				{
					"name": "comment.block.cva",
					"begin": "\\s*/\\*",
					"end": "\\*/",
					"patterns": [
						{
							"include": "#empty_line"
						},
						{
							"match": ".*?(?=\\*/)"
						}
					]
				},
				{
					"include": "#empty_line"
				}
			]
		},
		"empty_line": {
			"name": "entity.empty-line.cva",
			"match": "^\\s*$"
		},
		"comment_doc": {
			"patterns": [
				{
					"name": "comment.block.documentation.cva.doc",
					"match": "\\s*\\*\\s+(@)([a-z][a-zA-Z0-9_\\.]*)\\s+(.*)",
					"captures": {
						"1": {
							"name": "punctuation.decorator.cva.doc"
						},
						"2": {
							"name": "storage.type.class.cva.doc"
						},
						"3": {
							"name": "comment.block.documentation.cva.doc.raw"
						}
					}
				},
				{
					"name": "comment.block.documentation.cva",
					"match": "\\s*\\*\\s+(.*)",
					"captures": {
						"1": {
							"name": "comment.block.documentation.cva"
						}
					}
				}
			]
		},
		"keyword": {
			"match": "(?:\\b(variant|enum|type|options|struct)\\b)",
			"name": "entity.keyword.cva",
			"captures": {
				"0": { "name": "keyword.control.type.cva" }
			}
		},
		"punctuation": {
			"match": "(?:\\b(\{|\})\\b)",
			"name": "entity.punctuation.cva",
			"captures": {
				"0": { "name": "punctuation.any.cva" }
			}
		}
	}
}
